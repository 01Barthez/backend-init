# Dependencies & build output
node_modules
dist
coverage
*.tsbuildinfo

# Git / IDE
.git
.github
.vscode
.idea
*.swp
*.swo

# Env & secrets (injected at runtime via Compose env_file / secrets)
.env
.env.*
!.env.example
keys/*.pem
keys/*.key

# Local tooling / docs not needed in the image
tests
docs/architecture
docs/development
docs/deployment
docs/guides
*.md
!docs/api/openapi.yaml

# Docker / compose files (not copied into the image context recursively as source)
Dockerfile
docker-compose*.yml
infra/docker/docker-compose*.yml

# Logs & OS junk
logs
*.log
.DS_Store
Thumbs.db

# Lockfiles for alternate package managers (npm lock is copied explicitly)
bun.lock
bun.lockb
