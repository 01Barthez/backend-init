<%- include('partials/shell-open', { pageTitle: 'Password changed — ' + appName }) %>
<%- include('partials/header', { eyebrow: 'Security', title: 'Password updated', tone: 'success' }) %>
<tr>
  <td class="mail-body" style="padding:36px 32px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      Your <strong style="color:<%= colors.text %>;"><%= appName %></strong> password was changed on
      <strong style="color:<%= colors.text %>;"><%= date %></strong>.
    </p>

    <div class="mail-panel mail-panel-success" style="background:<%= colors.successSoft %>;border-left:4px solid <%= colors.success %>;border-radius:12px;padding:18px 20px;margin:22px 0;font-size:14px;color:<%= colors.text %>;">
      If you made this change, you’re all set. If you did not, reset your password now and contact support.
    </div>

    <% if (clientUrl) { %>
      <%- include('partials/cta', { href: clientUrl, label: 'Secure my account', variant: 'brand' }) %>
    <% } else if (supportEmail) { %>
      <%- include('partials/cta', { href: 'mailto:' + supportEmail, label: 'Contact support', variant: 'danger' }) %>
    <% } %>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
