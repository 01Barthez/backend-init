<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign-in alert - <%= appName %></title>
  <style>
    body {
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      background-color: #f8f9fb;
      margin: 0;
      padding: 0;
      color: #333;
    }

    .container {
      max-width: 700px;
      margin: 40px auto;
      background-color: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

    .header {
      background-color: #8b0000;
      background-image: linear-gradient(120deg, #8b0000, #b22222);
      padding: 30px;
      text-align: center;
      color: #fff;
    }

    .content {
      padding: 40px 35px;
      line-height: 1.7;
    }

    .content h2 {
      color: #8b0000;
      margin-bottom: 10px;
    }

    .content p {
      font-size: 0.95em;
      color: #444;
    }

    .warning {
      background-color: #fff4f4;
      border-left: 4px solid #b22222;
      padding: 15px 20px;
      border-radius: 8px;
      margin: 25px 0;
      font-size: 0.9em;
      color: #700000;
    }

    .footer {
      background-color: #fafafa;
      border-top: 1px solid #eee;
      padding: 25px 30px;
      text-align: center;
      font-size: 0.85em;
      color: #777;
    }

    .footer a {
      color: #b22222;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="header">
      <h1>New sign-in to your account</h1>
    </div>

    <div class="content">
      <h2>Hello <%= name %>,</h2>
      <p>A new sign-in to your <strong><%= appName %></strong> account was detected:</p>

      <div class="warning">
        <p><strong>IP address:</strong>
          <%= ip %><br>
            <strong>Location:</strong>
            <%= location %><br>
              <strong>Date:</strong>
              <%= date %><br>
                <strong>Device:</strong>
                <%= device %>
        </p>
      </div>

      <p>If this was you, you can ignore this message.
        If not, we recommend that you <strong>reset your password immediately</strong>.</p>

      <p>Account security is important to us.
        For assistance, contact
        <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %>">support</a>.</p>
    </div>

    <div class="footer">
      <p>&copy; <%= typeof year !== 'undefined' ? year : new Date().getFullYear() %> <%= appName %>. All rights reserved.</p>
      <p>Contact: <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %>"><%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %></a></p>
      <div class="social">
        <a href="#">Facebook</a> |
        <a href="#">Instagram</a> |
        <a href="#">LinkedIn</a> |
        <a href="#">YouTube</a>
      </div>
    </div>
  </div>

</body>

</html>


<!--* Variables -->
<!--
  <%= name %>, <%= ip %>, <%= location %>, <%= date %>, <%= device %>, <%= appName %>,
  <%= supportEmail %> (optional), <%= year %> (optional)
-->
