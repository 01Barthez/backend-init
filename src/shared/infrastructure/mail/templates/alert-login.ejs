<%- include('partials/shell-open', { pageTitle: 'Sign-in alert — ' + appName }) %>
<%- include('partials/header', { eyebrow: 'Security alert', title: 'New sign-in detected', tone: 'danger' }) %>
<tr>
  <td class="mail-body" style="padding:36px 32px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      A new sign-in to your <strong style="color:<%= colors.text %>;"><%= appName %></strong> account was recorded:
    </p>

    <div class="mail-panel mail-panel-danger" style="background:<%= colors.dangerSoft %>;border-left:4px solid <%= colors.danger %>;border-radius:12px;padding:18px 20px;margin:22px 0;">
      <div class="mail-meta-row" style="padding:8px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">IP address</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= ip %></span>
      </div>
      <div class="mail-meta-row" style="padding:8px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Location</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= location %></span>
      </div>
      <div class="mail-meta-row" style="padding:8px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Date</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= date %></span>
      </div>
      <div class="mail-meta-row" style="padding:8px 0;">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Device</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= device %></span>
      </div>
    </div>

    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      If this was you, no action is needed. If not, reset your password immediately and contact support.
    </p>

    <% if (clientUrl) { %>
      <%- include('partials/cta', { href: clientUrl, label: 'Review account security', variant: 'danger' }) %>
    <% } else if (supportEmail) { %>
      <%- include('partials/cta', { href: 'mailto:' + supportEmail, label: 'Contact support', variant: 'danger' }) %>
    <% } %>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
