<%- include('partials/shell-open', { pageTitle: 'Reset your password — ' + appName }) %>
<%- include('partials/header', { eyebrow: 'Security', title: 'Password reset', tone: 'warning' }) %>
<tr>
  <td class="mail-body" style="padding:36px 32px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      We received a request to reset the password for your <strong style="color:<%= colors.text %>;"><%= appName %></strong> account.
    </p>

    <%- include('partials/cta', { href: resetLink, label: 'Reset my password', variant: 'brand' }) %>

    <div class="mail-panel mail-panel-warning" style="background:<%= colors.warningSoft %>;border-left:4px solid <%= colors.warning %>;border-radius:12px;padding:18px 20px;margin:22px 0;font-size:14px;color:<%= colors.text %>;">
      This link expires in <strong>15 minutes</strong>. If you did not request a reset, ignore this email — your current password stays unchanged.
    </div>

    <p style="margin:0;font-size:13px;line-height:1.6;color:<%= colors.textMuted %>">
      Button not working? Paste this URL into your browser:<br/>
      <a href="<%= resetLink %>" style="color:<%= colors.primary %>;word-break:break-all;"><%= resetLink %></a>
    </p>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
