<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Account deleted - <%= appName %></title>
</head>
<body>
  <h2>Hello <%= name %>,</h2>
  <p>Your account on <%= appName %> was deleted on <%= date %>.</p>
  <p>If you did not request this action, please contact support immediately at
    <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %>"><%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %></a>.</p>
  <p>&copy; <%= year %> <%= appName %>. All rights reserved.</p>
</body>
</html>

<!--* Variables -->
<%# Template locals documented in mail.types / callers %>
