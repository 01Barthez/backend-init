<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Role updated - <%= appName %></title>
</head>
<body>
  <h2>Hello <%= name %>,</h2>
  <p>Your role on <%= appName %> was updated to <strong><%= role %></strong> on <%= date %>.</p>
  <p>If you have questions about this change, contact your administrator or
    <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %>"><%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@example.com' %></a>.</p>
  <p>&copy; <%= year %> <%= appName %>. All rights reserved.</p>
</body>
</html>

<!--* Variables -->
<!-- <%= name %>, <%= appName %>, <%= role %>, <%= date %>, <%= year %>, <%= supportEmail %> (optional) -->
