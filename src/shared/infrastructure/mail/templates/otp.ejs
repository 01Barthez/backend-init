<%- include('partials/shell-open', { pageTitle: appName + ' — Verification code' }) %>
<%- include('partials/header', { eyebrow: 'Account verification', title: appName, tone: 'brand' }) %>
<tr>
  <td class="mail-body" style="padding:36px 32px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      To finish verifying your <strong style="color:<%= colors.text %>;"><%= appName %></strong> account, enter this one-time code:
    </p>

    <div class="mail-code" style="background:<%= colors.primarySoft %>;border:2px dashed <%= colors.primary %>;color:<%= colors.primaryDark %>;font-weight:700;font-size:32px;letter-spacing:10px;text-align:center;border-radius:12px;padding:22px 12px;margin:24px 0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;">
      <%= otp %>
    </div>

    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      This code is <span style="color:<%= colors.primary %>;font-weight:600;">valid for 10 minutes</span>.
      If you did not request it, you can safely ignore this message.
    </p>

    <% if (clientUrl) { %>
      <%- include('partials/cta', { href: clientUrl, label: 'Open ' + appName, variant: 'brand' }) %>
    <% } %>

    <p style="margin:18px 0 0;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      Thank you for using <span style="color:<%= colors.primary %>;font-weight:600;"><%= appName %></span>.
    </p>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
