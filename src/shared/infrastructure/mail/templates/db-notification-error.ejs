<%- include('partials/shell-open', { pageTitle: 'Backup failed — ' + appName }) %>
<%- include('partials/header', { eyebrow: 'System alert', title: 'Database backup failed', tone: 'danger' }) %>
<tr>
  <td class="mail-body" style="padding:36px 32px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;">Hello,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      An error occurred during the automatic database backup for
      <strong style="color:<%= colors.text %>;"><%= appName %></strong>.
    </p>

    <div class="mail-panel mail-panel-danger" style="background:<%= colors.dangerSoft %>;border-left:4px solid <%= colors.danger %>;border-radius:12px;padding:18px 20px;margin:22px 0;">
      <div class="mail-meta-row" style="padding:8px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Incident date</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= date %></span>
      </div>
      <div class="mail-meta-row" style="padding:8px 0;<%= typeof stackTrace !== 'undefined' && stackTrace ? 'border-bottom:1px dashed ' + colors.border + ';' : '' %>">
        <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Error message</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= errorMessage %></span>
      </div>
      <% if (typeof stackTrace !== 'undefined' && stackTrace) { %>
        <div class="mail-meta-row" style="padding:8px 0;">
          <span class="mail-meta-label" style="color:<%= colors.textMuted %>;font-weight:600;font-size:12px;">Stack trace</span>
          <div class="mail-stack" style="background:#0F172A;color:#E2E8F0;border-radius:8px;padding:14px;margin-top:10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;white-space:pre-wrap;"><%= stackTrace %></div>
        </div>
      <% } %>
    </div>

    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>">
      Check server logs and disk space before retrying. Escalate if the failure repeats.
    </p>

    <% if (supportEmail) { %>
      <%- include('partials/cta', { href: 'mailto:' + supportEmail + '?subject=' + encodeURIComponent('Backup error — ' + appName), label: 'Contact support', variant: 'danger' }) %>
    <% } %>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
