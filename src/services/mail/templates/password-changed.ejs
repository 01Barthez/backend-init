<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Password Changed</title>
</head>
<body>
  <h2>Hello <%= name %>,</h2>
  <p>Your password on <%= appName %> was changed on <%= date %>.</p>
  <p>If you did not make this change, please reset your password immediately.</p>
  <p>&copy; <%= year %> <%= appName %></p>
</body>
</html>
